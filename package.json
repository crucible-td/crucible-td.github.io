{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/node_modules/**' --exclude 'tests/campaign.test.ts' --exclude 'tests/diversity.test.ts'",
    "typecheck": "tsc --noEmit",
    "sim": "node src/headless.ts",
    "campaign": "node src/campaign.ts",
    "diversity": "node src/diversity.ts",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
